# ParcelVision configuration — copy to .env and adjust.
# All services read from this single file via docker-compose `env_file`.

# --- Postgres / PostGIS ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=parcelvision
POSTGRES_USER=parcelvision
POSTGRES_PASSWORD=parcelvision-dev-only

# --- Redis / job queue ---
REDIS_URL=redis://redis:6379/0

# --- Inference ---
# rfdetr    : RF-DETR-Seg (merve/rf-detr-seg-satellite-buildings) via transformers. DEFAULT.
#             Best on residential parcels with leaf-off imagery — F1 0.64 (vs 0.25 for
#             Mask R-CNN on the same). See worker/scripts/eval_detectors.py.
# local_cpu : pretrained Mask R-CNN (geoai) on CPU. Trained on leaf-ON NAIP, so it
#             over-detects on leaf-off imagery; kept as an alternative / NAIP baseline.
# local_gpu : Mask R-CNN on CUDA — requires a GPU-enabled worker host + nvidia runtime.
# endpoint  : hosted inference endpoint (stub; see worker/worker/backends/endpoint.py).
# fake      : deterministic synthetic footprints, NO ML deps. Tests/CI only — never demo it as real output.
INFERENCE_BACKEND=rfdetr

# Max bounding-box area in km^2 a user may submit. Keeps CPU inference jobs tolerable.
AOI_BBOX_LIMIT_KM2=1.0

# Minimum detector score to keep a footprint (higher = fewer false positives,
# lower recall). Tuned on leaf-off residential parcels.
DETECTION_CONFIDENCE=0.3

# --- Imagery source ---
# Primary aerial imagery source; the others act as ordered fallbacks.
# mo_leafoff : Missouri statewide 6-inch LEAF-OFF ortho (MSDIS ImageServer).
#              Default. Higher-res than NAIP + no summer tree canopy over roofs;
#              Missouri only (falls through elsewhere). Requested at ~0.6 m to
#              match the detectors' training resolution.
# naip       : USDA NAIP via Planetary Computer. Nationwide but leaf-ON + flaky.
# esri       : Esri World Imagery export. Last-resort resilience fallback.
IMAGERY_SOURCE=mo_leafoff
IMAGERY_FALLBACK=1

# NAIP year to prefer (blank = most recent available from Planetary Computer)
NAIP_YEAR=

# --- Parcel validation (Chapter 3) ---
# Authoritative parcel source: any ArcGIS REST layer supporting /query.
# Default is St. Louis County's public parcels layer.
PARCEL_SERVICE_URL=https://maps.stlouisco.com/hosting/rest/services/Maps/AGS_Parcels/MapServer/0
PARCEL_LOCATOR_FIELD=LOCATOR
PARCEL_ADDRESS_FIELD=PROP_ADD

# --- API ---
API_PORT=8000
# CORS origin of the frontend during local dev (nginx proxies in compose, so this is belt-and-braces)
FRONTEND_ORIGIN=http://localhost:3000
# "development" or "production". Production refuses to boot on the dev DB password.
APP_ENV=development
LOG_LEVEL=INFO
# Per-client cap on job creation per minute (0 disables). A CPU job costs minutes.
JOB_RATE_LIMIT_PER_MIN=10

# --- Frontend ---
FRONTEND_PORT=3000
