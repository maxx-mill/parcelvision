# ParcelVision configuration — copy to .env and adjust.
# All services read from this single file via docker-compose `env_file`.

# --- Postgres / PostGIS ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=parcelvision
POSTGRES_USER=parcelvision
POSTGRES_PASSWORD=parcelvision-dev-only

# --- Redis / job queue ---
REDIS_URL=redis://redis:6379/0

# --- Inference ---
# local_cpu : pretrained Mask R-CNN (geoai) on CPU inside the worker container. Default.
# local_gpu : same model on CUDA — requires a GPU-enabled worker host + nvidia runtime.
# endpoint  : hosted inference endpoint (stub; see worker/worker/backends/endpoint.py).
# fake      : deterministic synthetic footprints, NO ML deps. Tests/CI only — never demo it as real output.
INFERENCE_BACKEND=local_cpu

# Max bounding-box area in km^2 a user may submit. Keeps CPU inference jobs tolerable.
AOI_BBOX_LIMIT_KM2=1.0

# NAIP year to prefer (blank = most recent available from Planetary Computer)
NAIP_YEAR=

# --- API ---
API_PORT=8000
# CORS origin of the frontend during local dev (nginx proxies in compose, so this is belt-and-braces)
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
