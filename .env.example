# ParcelVision configuration — copy to .env and adjust.
# All services read from this single file via docker-compose `env_file`.

# --- Postgres / PostGIS ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=parcelvision
POSTGRES_USER=parcelvision
POSTGRES_PASSWORD=parcelvision-dev-only

# --- Redis / job queue ---
REDIS_URL=redis://redis:6379/0

# --- Inference ---
# local_cpu : pretrained Mask R-CNN (geoai) on CPU inside the worker container. Default.
#             Best recall; over-detects (more phantom structures per parcel).
# rfdetr    : RF-DETR-Seg (merve/rf-detr-seg-satellite-buildings) via transformers.
#             Best precision — cleaner per-structure footprints, the parcel-use-case bias.
#             See worker/scripts/eval_detectors.py for the comparison behind this.
# local_gpu : Mask R-CNN on CUDA — requires a GPU-enabled worker host + nvidia runtime.
# endpoint  : hosted inference endpoint (stub; see worker/worker/backends/endpoint.py).
# fake      : deterministic synthetic footprints, NO ML deps. Tests/CI only — never demo it as real output.
INFERENCE_BACKEND=local_cpu

# Max bounding-box area in km^2 a user may submit. Keeps CPU inference jobs tolerable.
AOI_BBOX_LIMIT_KM2=1.0

# NAIP year to prefer (blank = most recent available from Planetary Computer)
NAIP_YEAR=

# --- Parcel validation (Chapter 3) ---
# Authoritative parcel source: any ArcGIS REST layer supporting /query.
# Default is St. Louis County's public parcels layer.
PARCEL_SERVICE_URL=https://maps.stlouisco.com/hosting/rest/services/Maps/AGS_Parcels/MapServer/0
PARCEL_LOCATOR_FIELD=LOCATOR
PARCEL_ADDRESS_FIELD=PROP_ADD

# --- API ---
API_PORT=8000
# CORS origin of the frontend during local dev (nginx proxies in compose, so this is belt-and-braces)
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
